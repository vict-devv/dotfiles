# Minimal tmux - Tokyo Night

# ── Prefix: Ctrl+A ───────────────────────────────────────────
unbind C-b
set -g prefix C-a
bind C-a send-prefix            # press Ctrl+A twice to send Ctrl+A to the app

# ── General ──────────────────────────────────────────────────
set -g default-terminal "tmux-256color"
set -ag terminal-overrides ",xterm-256color:RGB"
set -g mouse on
set -g history-limit 5000
set -sg escape-time 10          # snappy Esc in Neovim
set -g focus-events on
set -g set-clipboard on
set -g base-index 1             # windows start at 1
setw -g pane-base-index 1
set -g renumber-windows on
set -g detach-on-destroy off    # closing a session jumps to another one
setw -g mode-keys vi

# ── Keybindings ──────────────────────────────────────────────
bind r source-file ~/.config/tmux/tmux.conf \; display "tmux.conf reloaded"

# Splits open in the current directory
bind | split-window -h -c "#{pane_current_path}"
bind - split-window -v -c "#{pane_current_path}"
bind c new-window -c "#{pane_current_path}"
unbind '"'
unbind %

# Vim-style pane navigation and resizing
bind h select-pane -L
bind j select-pane -D
bind k select-pane -U
bind l select-pane -R
bind -r H resize-pane -L 5
bind -r J resize-pane -D 5
bind -r K resize-pane -U 5
bind -r L resize-pane -R 5

# Vi copy mode: v to select, y to copy
bind -T copy-mode-vi v send -X begin-selection
bind -T copy-mode-vi y send -X copy-selection-and-cancel

# ── Tokyo Night Theme ──────────────────────────────────────
# bg #1a1b26  fg #c0caf5  muted #565f89  border #3b4261
# blue #7aa2f7  purple #bb9af7  cyan #7dcfff  green #9ece6a  yellow #e0af68

# Panes
set -g pane-border-style "fg=#3b4261"
set -g pane-active-border-style "fg=#7aa2f7"
set -g display-panes-active-colour "#7aa2f7"
set -g display-panes-colour "#565f89"

# Messages and copy mode
set -g message-style "fg=#7aa2f7,bg=#1a1b26,bold"
set -g message-command-style "fg=#7aa2f7,bg=#1a1b26"
setw -g mode-style "fg=#1a1b26,bg=#bb9af7"
setw -g clock-mode-colour "#7aa2f7"

# ── Status bar ───────────────────────────────────────────────
set -g status on
set -g status-position bottom
set -g status-interval 5
set -g status-justify left
set -g status-style "bg=default,fg=#565f89"   # transparent - blends with the terminal

# Left: session name (blue; turns purple while the prefix is held)
set -g status-left-length 40
set -g status-left "#{?client_prefix,#[fg=#bb9af7],#[fg=#7aa2f7]}#[bold]  #S #[default]  "

# Windows: muted when inactive, blue and bold when active, Z when zoomed
setw -g window-status-separator "  "
setw -g window-status-format "#[fg=#565f89]#I #W"
setw -g window-status-current-format "#[fg=#7aa2f7,bold]#I #W#{?window_zoomed_flag, ,}"
setw -g window-status-activity-style "fg=#e0af68"
setw -g window-status-bell-style "fg=#f7768e"

# Right: date and time
set -g status-right-length 60
set -g status-right "#[fg=#565f89] %a %d %b  #[fg=#7dcfff] %H:%M "
