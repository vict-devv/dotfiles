// Minimal Tokyo Night
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "pop_small",
    "color": { "1": "38;2;122;162;247", "2": "38;2;187;154;247" },
    "padding": { "top": 1, "left": 2, "right": 3 }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "38;2;122;162;247", "title": "38;2;122;162;247", "output": "38;2;192;202;245", "separator": "38;2;86;95;137" },
    "key": { "width": 4 },
    "percent": {
      "type": 9,
      "color": { "green": "38;2;158;206;106", "yellow": "38;2;224;175;104", "red": "38;2;247;118;142" }
    }
  },
  "modules": [
    "break",
    { "type": "title", "format": "{user-name-colored}{at-symbol-colored}{host-name-colored}", "color": { "user": "38;2;187;154;247", "at": "38;2;86;95;137", "host": "38;2;122;162;247" } },
    { "type": "separator", "string": "─", "outputColor": "38;2;86;95;137" },
    { "type": "os", "key": "", "keyColor": "38;2;122;162;247" },
    { "type": "kernel", "key": "", "keyColor": "38;2;122;162;247" },
    { "type": "packages", "key": "󰏖", "keyColor": "38;2;122;162;247" },
    { "type": "shell", "key": "", "keyColor": "38;2;187;154;247" },
    { "type": "terminal", "key": "", "keyColor": "38;2;187;154;247" },
    { "type": "de", "key": "", "keyColor": "38;2;187;154;247" },
    { "type": "wm", "key": "", "keyColor": "38;2;187;154;247" },
    { "type": "cpu", "key": "", "keyColor": "38;2;125;207;255" },
    { "type": "gpu", "key": "󰢮", "keyColor": "38;2;125;207;255" },
    { "type": "memory", "key": "", "keyColor": "38;2;125;207;255" },
    { "type": "disk", "folders": "/", "key": "󰋊", "keyColor": "38;2;125;207;255" },
    { "type": "uptime", "key": "󰅐", "keyColor": "38;2;158;206;106" },
    "break",
    { "type": "colors", "symbol": "circle", "paddingLeft": 1 }
  ]
}
